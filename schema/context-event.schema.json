{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context-event.schema.json",
  "title": "ContextEvent (draft)",
  "type": "object",
  "required": ["id", "source", "kind", "t_start", "t_end", "t_observed", "provenance", "privacy"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "description": "ULID"},
    "source": {
      "type": "string",
      "description": "Built-in channel or namespaced producer channel, e.g. mail.message.",
      "maxLength": 100,
      "anyOf": [
        {"enum": ["voice", "clipboard", "browser", "ai_chat", "window"]},
        {"pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"}
      ]
    },
    "kind": {"type": "string", "description": "transcript_segment | copy | page_read | chat_turn | focus ..."},
    "t_start": {"type": "integer", "description": "Unix ms"},
    "t_end": {"type": "integer", "description": "Unix ms; equals t_start for instant events"},
    "tz": {"type": "string"},
    "tz_source": {"enum": ["recorded", "utc_fallback"]},
    "t_observed": {"type": "integer", "description": "Unix ms when written"},
    "device_id": {"type": "string"},
    "actor": {"type": "string", "description": "self | speaker_k | app | unknown"},
    "content": {
      "type": "object",
      "properties": {
        "text": {"type": "string"},
        "title": {"type": "string"},
        "url_norm": {"type": "string"},
        "lang": {"type": "string"},
        "content_hash": {"type": "string"},
        "summary": {"type": "string", "description": "Auto-curated concise summary"},
        "excerpts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text"],
            "properties": {
              "text": {"type": "string"},
              "locator": {"type": "string"},
              "note": {"type": "string"}
            }
          }
        },
        "markdown_locator": {"type": "string", "description": "Path or URI to generated clean Markdown artifact"}
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "app_bundle": {"type": "string"},
        "window_title": {"type": "string"},
        "dwell_ms": {"type": "integer", "minimum": 0},
        "scroll_depth": {"type": "number", "minimum": 0, "maximum": 1},
        "afk": {"type": "boolean"},
        "curation_tier": {"enum": ["transient", "auto_curated", "pinned"]},
        "interactions": {
          "type": "object",
          "properties": {
            "selection_count": {"type": "integer", "minimum": 0},
            "copy_count": {"type": "integer", "minimum": 0},
            "highlight_count": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "anchors": {"type": "array", "items": {"type": "string"}},
    "attention": {"type": "number", "minimum": 0, "maximum": 1},
    "episode_id": {"type": "string", "description": "Optional behavior episode / workflow identifier"},
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target_id", "relation"],
        "properties": {
          "target_id": {"type": "string"},
          "relation": {"type": "string", "description": "triggered_by | copied_to | discussed_in | same_anchor ..."},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        }
      }
    },
    "location": {
      "type": "object",
      "properties": {
        "lat": {"type": "number"},
        "lon": {"type": "number"},
        "place_name": {"type": "string"},
        "stay_id": {"type": "string"}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["connector", "source_id"],
      "properties": {
        "connector": {"type": "string"},
        "version": {"type": "string"},
        "source_id": {"type": "string"},
        "source_hash": {"type": "string"},
        "locator": {"type": "string"}
      }
    },
    "privacy": {
      "type": "object",
      "required": ["tier"],
      "properties": {
        "tier": {"enum": ["local_only", "redacted", "shareable"]},
        "pii_tags": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
