{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "record-for-agent-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "PUBLIC_ORIGIN": "https://gateway.invalid",
    "APPLE_APP_ID": "CONFIGURE_APP_BUNDLE_ID_BEFORE_DEPLOYMENT",
    "CLOUDKIT_CONTAINER": "CONFIGURE_CLOUDKIT_CONTAINER_BEFORE_DEPLOYMENT"
  },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "REPLACE_ONLY_AFTER_APPROVED_RESOURCE_CREATION" }],
  "d1_databases": [{
    "binding": "DB", "database_name": "record-for-agent-gateway",
    "database_id": "REPLACE_ONLY_AFTER_APPROVED_RESOURCE_CREATION", "migrations_dir": "migrations"
  }]
}
