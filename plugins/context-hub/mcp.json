{
  "mcpServers": {
    "raw-memory": {
      "command": "uv",
      "args": [
        "--directory",
        "<PATH_TO_CONTEXT_INSTRUMENTALITY_REPO>",
        "run",
        "raw-memory",
        "mcp"
      ],
      "env": {
        "CONTEXT_HUB_WORKBENCH_URL": "http://127.0.0.1:8741"
      }
    }
  }
}
