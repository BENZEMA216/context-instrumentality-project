{
  "name": "raw-memory",
  "version": "0.2.0",
  "description": "Raw Memory — Local-first personal raw data & evidence-gated Memory engine plugin rooted inside your AI Agent (MCP recall, Agent-as-Curator rules, and deep-linkable Workbench views).",
  "entry_experience": "agent-plugin-with-web-deeplinks",
  "workbench_base_url": "http://127.0.0.1:8741",
  "mcp_servers": {
    "raw-memory": {
      "command": "uv",
      "args": ["run", "raw-memory", "mcp"]
    }
  },
  "skills": [
    "skills/context-recall/SKILL.md",
    "../../skills/context-curator/SKILL.md"
  ],
  "deeplinks": {
    "timeline": "/#/timeline",
    "episode": "/#/episodes/{episode_id}",
    "project": "/#/projects/{project}",
    "memory_index": "/#/artifacts/MEMORY.md",
    "artifact": "/#/artifacts/{path}",
    "curator": "/#/curator",
    "channels": "/#/channels",
    "vault": "/#/vault"
  }
}
